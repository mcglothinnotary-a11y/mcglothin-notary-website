<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Contact Us - McGlothin Notary Services LLC</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 0;
            background-color: #f9f9f9;
            color: #333;
        }
        header {
            background-color: #4a90e2;
            color: white;
            padding: 20px 0;
            text-align: center;
        }
        header img {
            max-width: 150px;
            margin-bottom: 10px;
        }
        main {
            max-width: 800px;
            margin: 40px auto;
            padding: 0 20px;
        }
        h1 {
            text-align: center;
            color: #4a90e2;
        }
        .contact-info, .contact-form {
            background-color: white;
            padding: 25px;
            margin-bottom: 30px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
            border-radius: 8px;
        }
        .contact-info p {
            margin: 10px 0;
        }
        form {
            display: flex;
            flex-direction: column;
        }
        input, textarea {
            padding: 12px;
            margin: 8px 0;
            border: 1px solid #ccc;
            border-radius: 6px;
            font-size: 16px;
        }
        textarea {
            resize: vertical;
        }
        button {
            background-color: #4a90e2;
            color: white;
            padding: 14px;
            border: none;
            border-radius: 6px;
            font-size: 16px;
            cursor: pointer;
            margin-top: 10px;
        }
        button:hover {
            background-color: #357ab8;
        }
        footer {
            text-align: center;
            padding: 20px 0;
            background-color: #f1f1f1;
            color: #777;
        }
        @media(max-width: 600px) {
            header img {
                max-width: 120px;
            }
        }
    </style>
</head>
<body>

<header>
    <img src="Logo.png" alt="McGlothin Notary Services LLC Logo">
    <h2>McGlothin Notary Services LLC</h2>
</header>

<main>
    <h1>Contact Us</h1>

    <div class="contact-info">
        <h2>Our Contact Info</h2>
        <p><strong>Address:</strong> 123 Main Street, Atlanta, GA 30301</p>
        <p><strong>Phone:</strong> (470) 210-4549</p>
        <p><strong>Email:</strong> info@mcglothinnotary.com</p>
        <p><strong>Business Hours:</strong> Mon-Fri 9:00 AM - 6:00 PM</p>
    </div>

    <div class="contact-form">
        <h2>Send Us a Message</h2>
        <form action="mailto:info@mcglothinnotary.com" method="POST" enctype="text/plain">
            <input type="text" name="name" placeholder="Your Name" required>
            <input type="email" name="email" placeholder="Your Email" required>
            <input type="text" name="subject" placeholder="Subject" required>
            <textarea name="message" rows="6" placeholder="Your Message" required></textarea>
            <button type="submit">Send Message</button>
        </form>
    </div>
</main>

<footer>
    &copy; 2025 McGlothin Notary Services LLC. All rights reserved.
</footer>

</body>
</html>
